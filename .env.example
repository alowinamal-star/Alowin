# PromptShield AI — environment configuration example.
# Copy to .env (or set in your platform's settings) and adjust.
# Nothing here is required to run locally: every value has a safe default.
# Never commit real secrets.

# --- Storage ---------------------------------------------------------------
# When set, all documents go to MongoDB. When empty, an embedded SQLite
# document store under DATA_DIR is used (zero external services).
MONGODB_URI=
MONGODB_DB=promptshield

# --- Authentication --------------------------------------------------------
# If empty, a random signing key is generated once and persisted in the store.
PROMPTSHIELD_SECRET=
TOKEN_TTL_SECONDS=28800

# Seeded administrator (change the password before any real deployment).
SEED_ADMIN_EMAIL=admin@promptshield.ai
SEED_ADMIN_PASSWORD=Admin@12345
# Demo analyst/viewer accounts for the walkthrough. SEED_DEMO_USERS=0 disables
# them and the /api/auth/demo-accounts endpoint.
SEED_DEMO_USERS=1
SEED_DEMO_PASSWORD=Demo@12345
# Set to 0 for a clean database with no example scans.
SEED_DEMO_SCANS=1

# --- HTTP hardening --------------------------------------------------------
# Comma-separated origins allowed to call the API cross-origin. Empty = same-origin only.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SCAN_PER_MINUTE=30
MAX_UPLOAD_BYTES=8388608
MAX_TEXT_CHARS=200000

# --- URL scanner (SSRF guard) ---------------------------------------------
URL_FETCH_TIMEOUT=8
URL_MAX_BYTES=2097152
URL_MAX_REDIRECTS=3
# Keep 0 in production: private/loopback/link-local addresses are refused.
ALLOW_PRIVATE_URL_FETCH=0

# --- Optional external LLM stage ------------------------------------------
# The pipeline runs fully without these. Content is always passed to the model
# as an untrusted, clearly delimited envelope. Leave empty to disable outbound
# LLM calls entirely (no document content leaves the process).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=20

# --- Smart Action Firewall -------------------------------------------------
# Comma-separated recipient domains that outbound email may target.
FIREWALL_EMAIL_ALLOWLIST=
TRANSFER_APPROVAL_THRESHOLD=500
TRANSFER_HARD_LIMIT=5000

# --- Paths (defaults are correct for the container) ------------------------
# DATA_DIR=/app/backend/data
# MODEL_PATH=/app/backend/ml/model.json
# DATASET_DIR=/app/backend/data/dataset
# FRONTEND_DIST=/app/backend/frontend_dist
